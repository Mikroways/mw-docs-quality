{
  "name": "@mikroways/docs-quality",
  "version": "2.7.0",
  "description": "Herramientas de calidad de documentación para proyectos Mikroways (cSpell, markdownlint, CI templates)",
  "private": false,
  "scripts": {
    "prepare": "git config core.hooksPath hooks || true",
    "build:es-ar": "cspell-tools compile-trie -M es-ar -o dictionaries node_modules/dictionary-es-ar/index.dic"
  },
  "publishConfig": {
    "@mikroways:registry": "https://gitlab.com/api/v4/projects/81783404/packages/npm/"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.21.0",
    "@cspell/cspell-tools": "10.4.0",
    "dictionary-es-ar": "2.0.0"
  },
  "dependencies": {
    "@cspell/dict-es-es": "*",
    "cspell": "^10.0.0"
  }
}
